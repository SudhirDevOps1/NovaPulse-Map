# Normalise line endings so CI and local checkouts don't churn diffs.
* text=auto eol=lf

*.js   text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.ts   text eol=lf

# Treat these as binary — never let git touch their line endings.
*.png  binary
*.jpg  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.map  binary

.editorconfig linguist-language=JavaScript linguist-vendored=false